# Copy to .env.local. Never commit .env.local.
#
# NEXT_PUBLIC_* values are compiled into the browser bundle and are therefore
# public. That is correct for the Supabase anon key -- it is designed to be
# public, and RLS is what makes it safe. The service role key must NEVER appear
# here: it bypasses every policy in the database and belongs only on the API.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The FastAPI backend.
NEXT_PUBLIC_API_URL=http://localhost:8000
