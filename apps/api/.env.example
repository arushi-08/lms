# Copy to .env for local development. Never commit .env.
# Every value here is a placeholder -- no real secret belongs in this file.

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
# Public by design; safe only because RLS is on. Shipped to the browser.
SUPABASE_ANON_KEY=
# Bypasses RLS. Backend only. If this ever reaches a browser bundle, rotate it.
SUPABASE_SERVICE_ROLE_KEY=
# Only for legacy HS256 projects. Leave blank to verify via JWKS.
SUPABASE_JWT_SECRET=

# Use the pooled connection string (port 6543) -- Supabase free tier has few
# direct connections and Render restarts will exhaust them otherwise.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- HTTP -------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000"]

# --- Video ------------------------------------------------------------------
# mock until the VdoCipher account exists; production refuses to start on mock.
VIDEO_PROVIDER=mock
VDOCIPHER_API_SECRET=
VDOCIPHER_OTP_TTL_SECONDS=300
VIDEO_WATERMARK_ENABLED=true
VIDEO_MAX_CONCURRENT_SESSIONS=2

# --- Payments ---------------------------------------------------------------
# none for the pilot: Stripe is not approved and no price is set.
PAYMENT_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Observability ----------------------------------------------------------
SENTRY_DSN=
